#include <Wire.h>
#include <LiquidCrystal_I2C.h>

LiquidCrystal_I2C lcd(0x27, 16, 2);

// Cell input pins
const int cellPins[4] = {34, 35, 32, 33};

// Task 2 hardware
const int RELAY_PIN = 25;
const int BUZZER_PIN = 26;

// Thresholds
const float MIN_CELL_VOLTAGE = 3.0;
const float MAX_CELL_VOLTAGE = 4.2;
const float RAPID_CHANGE_LIMIT = 0.50;

// Timing
const unsigned long SENSOR_INTERVAL = 200;
const unsigned long SCREEN_INTERVAL = 3000;
const unsigned long LCD_UPDATE_INTERVAL = 300;

float cellVoltage[4] = {3.7, 3.7, 3.7, 3.7};
float previousVoltage[4] = {3.7, 3.7, 3.7, 3.7};

float averageVoltage = 0;
float highestVoltage = 0;
float lowestVoltage = 0;
float imbalance = 0;

bool weakCell = false;
bool overVoltage = false;
bool sensorFault = false;
bool rapidChange = false;

unsigned long lastSensorTime = 0;
unsigned long lastScreenTime = 0;
unsigned long lastLCDUpdate = 0;

int currentScreen = 0;
bool criticalFault = false;

enum SystemState {
  NORMAL,
  WARNING,
  FAULT
};

SystemState systemState = NORMAL;


// ---------------- SETUP ----------------

void setup() {

  Serial.begin(115200);

  pinMode(RELAY_PIN, OUTPUT);
  pinMode(BUZZER_PIN, OUTPUT);

  digitalWrite(RELAY_PIN, HIGH);
  digitalWrite(BUZZER_PIN, LOW);

  Wire.begin(21, 22);

  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("EV BMS HMI");
  lcd.setCursor(0, 1);
  lcd.print("INITIALIZING...");

  lastSensorTime = millis();
  lastScreenTime = millis();
  lastLCDUpdate = millis();
}


// ---------------- SENSOR PROCESSING ----------------

void readBatteryData() {

  weakCell = false;
  overVoltage = false;
  sensorFault = false;
  rapidChange = false;

  float totalVoltage = 0;

  highestVoltage = 0;
  lowestVoltage = 10;

  for (int i = 0; i < 4; i++) {

    int rawValue = analogRead(cellPins[i]);

    cellVoltage[i] = (rawValue / 4095.0) * 4.5;

    totalVoltage += cellVoltage[i];

    if (cellVoltage[i] > highestVoltage)
      highestVoltage = cellVoltage[i];

    if (cellVoltage[i] < lowestVoltage)
      lowestVoltage = cellVoltage[i];

    if (cellVoltage[i] < 0.0 || cellVoltage[i] > 4.5)
      sensorFault = true;

    if (abs(cellVoltage[i] - previousVoltage[i]) > RAPID_CHANGE_LIMIT)
      rapidChange = true;

    if (cellVoltage[i] < MIN_CELL_VOLTAGE)
      weakCell = true;

    if (cellVoltage[i] > MAX_CELL_VOLTAGE)
      overVoltage = true;

    previousVoltage[i] = cellVoltage[i];
  }

  averageVoltage = totalVoltage / 4.0;

  imbalance = highestVoltage - lowestVoltage;
}


// ---------------- STATE MANAGEMENT ----------------

void updateProtectionState() {

  criticalFault =
    overVoltage ||
    sensorFault ||
    rapidChange;

  if (criticalFault) {

    systemState = FAULT;

    digitalWrite(RELAY_PIN, LOW);
    digitalWrite(BUZZER_PIN, HIGH);

  }

  else if (weakCell) {

    systemState = WARNING;

    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(BUZZER_PIN, LOW);

  }

  else {

    systemState = NORMAL;

    digitalWrite(RELAY_PIN, HIGH);
    digitalWrite(BUZZER_PIN, LOW);
  }
}


// ---------------- LCD HELPER ----------------

void printLine(int row, const char *text) {

  lcd.setCursor(0, row);

  lcd.print("                ");

  lcd.setCursor(0, row);

  lcd.print(text);
}


// ---------------- SCREEN 1 ----------------

void showBatteryScreen() {

  lcd.setCursor(0, 0);

  lcd.print("C1:");
  lcd.print(cellVoltage[0], 2);

  lcd.print(" C2:");
  lcd.print(cellVoltage[1], 2);

  lcd.setCursor(0, 1);

  lcd.print("C3:");
  lcd.print(cellVoltage[2], 2);

  lcd.print(" C4:");
  lcd.print(cellVoltage[3], 2);
}


// ---------------- SCREEN 2 ----------------

void showAnalyticsScreen() {

  lcd.setCursor(0, 0);

  lcd.print("AVG:");
  lcd.print(averageVoltage, 2);

  lcd.print("V");

  lcd.setCursor(0, 1);

  lcd.print("IMB:");
  lcd.print(imbalance, 2);

  lcd.print("V");
}


// ---------------- SCREEN 3 ----------------

void showProtectionScreen() {

  lcd.setCursor(0, 0);

  if (systemState == NORMAL)
    lcd.print("STATUS: NORMAL");

  else if (systemState == WARNING)
    lcd.print("STATUS: WARNING");

  else
    lcd.print("STATUS: FAULT");

  lcd.setCursor(0, 1);

  lcd.print("RELAY:");

  if (digitalRead(RELAY_PIN))
    lcd.print("ON ");
  else
    lcd.print("OFF");

  lcd.print(" BMS");
}


// ---------------- SCREEN 4 ----------------

void showFaultScreen() {

  lcd.setCursor(0, 0);
  lcd.print("!! FAULT !!     ");

  lcd.setCursor(0, 1);

  if (overVoltage)
    lcd.print("OVERVOLTAGE     ");

  else if (sensorFault)
    lcd.print("SENSOR ERROR    ");

  else if (rapidChange)
    lcd.print("RAPID CHANGE    ");

  else if (weakCell)
    lcd.print("WEAK CELL       ");

  else
    lcd.print("CHECK SYSTEM    ");
}


// ---------------- DISPLAY MANAGER ----------------

void updateLCD() {

  /*
     Critical faults always get priority.
     Normal diagnostic screens are shown only
     when the system is safe.
  */

  if (criticalFault) {

    showFaultScreen();

    return;
  }

  switch (currentScreen) {

    case 0:
      showBatteryScreen();
      break;

    case 1:
      showAnalyticsScreen();
      break;

    case 2:
      showProtectionScreen();
      break;
  }
}


// ---------------- SERIAL DIAGNOSTICS ----------------

void printDiagnostics() {

  Serial.println("-------------------------");

  Serial.print("C1: ");
  Serial.println(cellVoltage[0], 2);

  Serial.print("C2: ");
  Serial.println(cellVoltage[1], 2);

  Serial.print("C3: ");
  Serial.println(cellVoltage[2], 2);

  Serial.print("C4: ");
  Serial.println(cellVoltage[3], 2);

  Serial.print("Average: ");
  Serial.println(averageVoltage, 2);

  Serial.print("Imbalance: ");
  Serial.println(imbalance, 2);

  Serial.print("State: ");

  if (systemState == NORMAL)
    Serial.println("NORMAL");

  else if (systemState == WARNING)
    Serial.println("WARNING");

  else
    Serial.println("FAULT");
}


// ---------------- MAIN LOOP ----------------

void loop() {

  unsigned long currentMillis = millis();


  // Read sensors
  if (currentMillis - lastSensorTime >= SENSOR_INTERVAL) {

    lastSensorTime = currentMillis;

    readBatteryData();

    updateProtectionState();
  }


  // Rotate screens
  if (!criticalFault &&
      currentMillis - lastScreenTime >= SCREEN_INTERVAL) {

    lastScreenTime = currentMillis;

    currentScreen++;

    if (currentScreen > 2)
      currentScreen = 0;
  }


  // LCD refresh
  if (currentMillis - lastLCDUpdate >= LCD_UPDATE_INTERVAL) {

    lastLCDUpdate = currentMillis;

    updateLCD();
  }


  // Serial diagnostics
  static unsigned long lastSerial = 0;

  if (currentMillis - lastSerial >= 1000) {

    lastSerial = currentMillis;

    printDiagnostics();
  }
}
